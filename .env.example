# Directus
DIRECTUS_URL=http://localhost:8055
DIRECTUS_ADMIN_TOKEN=your-static-admin-token
DIRECTUS_SECRET=your-directus-secret
DIRECTUS_ADMIN_EMAIL=admin@ops-platform.com
DIRECTUS_ADMIN_PASSWORD=changeme

# Database (used by Directus)
DB_USER=ops_user
DB_PASSWORD=ops_password
DB_NAME=ops_platform

# API Gateway
JWT_SECRET=your-jwt-secret-min-32-chars-long-here
PORT=3001
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# Redis
REDIS_URL=redis://localhost:6379

# LangGraph (Python agent service)
LANGGRAPH_URL=http://localhost:8000
LANGGRAPH_API_KEY=your-langgraph-key

# Frontend
VITE_API_URL=http://localhost:3001/api/v1
VITE_WS_URL=http://localhost:3001
